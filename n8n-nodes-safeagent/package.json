{
  "name": "n8n-nodes-safeagent",
  "version": "0.2.0",
  "description": "n8n community node - SafeAgent execution guard (claim-before-execute idempotency pattern)",
  "keywords": [
    "n8n-community-node-package",
    "safeagent",
    "idempotency",
    "execution-guard",
    "ai-agent",
    "exactly-once",
    "duplicate-prevention",
    "webhook-idempotency",
    "agent-retry",
    "claim-before-execute",
    "workflow-guard"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/azender1/SafeAgent",
  "author": "Anthony Zender",
  "repository": {
    "type": "git",
    "url": "https://github.com/azender1/SafeAgent"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/SafeAgent/SafeAgent.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "eslint": "9.39.4",
    "@types/node": "^18.16.0",
    "n8n-workflow": "*",
    "typescript": "^5.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
